# Copy this file to repository-root .env. It contains paths/public settings, no secret values.
# Docker Compose v2.24+ with BuildKit and Linux containers is required.
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public, browser-accessible Devnet endpoint. Never use a private RPC credential here.
PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Required actual deployed Devnet address, matching packages/chain-client/idl/seatback.json.
SEATBACK_PROGRAM_ID=5PZki4JDVr8Cd1DTCGCiRHNgXAnZBjAAJVc9HSrmCR97
DISPUTE_AUTHORITY=
# Absolute paths; on Windows use C:/Users/... and Docker Desktop file sharing.
# These files must exist outside the repository and be readable by container UID 1000.
GATE_KEYPAIR_FILE=
POSTGRES_PASSWORD_FILE=
SESSION_SECRET_FILE=
ACCESS_CODE_PEPPER_FILE=
